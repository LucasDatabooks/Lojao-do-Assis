int main() {

    gerarlistaprodutos("listaprodutos.txt"); // Chama a função para gerar a lista de produtos
    excluirlistaprodutos(); // Chama a função de excluir produtos
    alterarlistaprodutos("listaprodutos.txt"); // Chama a função de alterar produtos criando um arquivo temporário e renomeando-o para o nome original
    checar("listaprodutos.txt"); // Apenas lê o arquivo e imprime seu conteúdo na tela
}

int gerarlistaprodutos (char *listaprodutos) {
    FILE *fp = fopen(listaprodutos, "w"); // Abre o arquivo para escrita
    FILE *fp2 = fopen("templistprod.txt", "w"); // Abre o arquivo temporário para escrita
    if (fp == NULL || fp2 == NULL) {
        printf("Erro ao criar arquivos.\n");
        return 0;
    }
    fclose(fp);
    fclose(fp2);
    return 1;
}
int excluirlistaprodutos () {
    if (remove("listaprodutos.txt") == 0)
printf("Lista removida com sucesso!\n");
else
printf("Erro ao deletar lista!\n");
return 0;
}
int alterarlistaprodutos (char *listaprodutos) {
    FILE *fp = fopen(listaprodutos, "r");
    FILE *templist = fopen("templistprod.txt", "r+");
    char linha [100];
    char produto[100];
    char preco[50];
    char quantidade[50];
    char fornecedor[100];
    printf("Digite qual o produto que deseja incluir ou alterar: ");
    scanf("%s", &produto);
    scanf("%f", &preco);
    scanf("%d", &quantidade);
    scanf("%s", &fornecedor);
    if (fp == NULL) {
        printf("lista não encontrada.\n");
        return 0;
     }
    if (templist == NULL) {
        printf("Erro ao fazer alteração.\n");
        return 0;
    }
    while (fgets(linha, sizeof(linha), fp)) {
        fputs(linha, templist);
    }
    fclose(fp);
    remove("listaprodutos.txt");
    rename("templistprod.txt", "listaprodutos.txt");
    fclose(templist);
    return 1;
}
int checar (char *listaprodutos) {
    FILE *fp = fopen(listaprodutos, "r");
    char linha[100];
    if (fp == NULL) {
        printf("Lista de produtos não encontrada.\n");
        return 0;
    }
    while (fgets(linha, sizeof(linha), fp)) {
        printf("%s", linha);
    }
    fclose(fp);
    return 1;
}
